# Dependencias locales (Se instalan en cada máquina)
node_modules/
jspm_packages/

# Código compilado (Se genera con npm run build, no va a Git)
dist/
out/

# Archivos de log/errores de npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos de configuración del sistema operativo
.DS_Store
Thumbs.db

# Configuración de entornos locales (si llegas a usarlos)
.env
.env.local
.env.development.local

# Archivos temporales de TypeScript
*.tsbuildinfo
